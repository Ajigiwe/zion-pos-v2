# Copy to .env on the VPS, then run: php artisan key:generate

APP_NAME="Zion Musical Centre POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.zionmusicalcentre.example

LOG_CHANNEL=daily
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────
# cPanel convention: cpaneluser_pos / cpaneluser_posuser (create in MySQL® Databases)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_pos
DB_USERNAME=cpaneluser_posuser
DB_PASSWORD=change-me

# ── Cache / queue / sessions ────────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=local

# ── POS ─────────────────────────────────────────────────────────────────────
POS_TILL_ID=Web-Till-1
POS_ALERT_EMAIL=admin@example.com
# On the VPS these binaries usually exist already; adjust if needed:
MYSQLDUMP_PATH=/usr/bin/mysqldump
MYSQL_PATH=/usr/bin/mysql
